# ──────────────────────────────────────────────────────────────
#  Copy this file to ".env" and fill in the values.
#  Vite only exposes variables that start with VITE_.
#  These are baked in at BUILD time – set them in your hosting
#  dashboard (Vercel/Netlify) too, then redeploy.
# ──────────────────────────────────────────────────────────────

# REQUIRED – URL of the deployed backend (no trailing slash)
# Local:      http://localhost:5000
# Production: https://campus-eats-api.onrender.com
VITE_API_URL=http://localhost:5000

# DEVELOPMENT ONLY – open the app in a normal browser without Telegram.
# Needs DEV_AUTH_BYPASS=true on the backend. Demo IDs from "npm run seed -- --demo":
#   1000001 cafe owner · 1000002 student · 1000003 driver · 1000004 admin
# Leave EMPTY in production.
VITE_DEV_TELEGRAM_ID=
