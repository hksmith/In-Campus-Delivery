# ──────────────────────────────────────────────────────────────
#  Copy this file to ".env" and fill in the values.
#  Lines marked REQUIRED must be set, the rest have defaults.
# ──────────────────────────────────────────────────────────────

# development | production
NODE_ENV=development
PORT=5000

# REQUIRED – MongoDB connection string (MongoDB Atlas free tier works fine)
# Example: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/campus_delivery
MONGODB_URI=mongodb://127.0.0.1:27017/campus_delivery

# REQUIRED – Bot token from @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Set to false to run the API without starting the Telegram bot (e.g. local testing)
ENABLE_BOT=true

# Public HTTPS URL where the FRONTEND is deployed (used for the "Open app" buttons)
# Example: https://campus-eats.vercel.app
MINI_APP_URL=

# Optional – public HTTPS URL of THIS backend. If set, the bot uses a webhook
# (recommended in production). If empty, the bot uses long polling.
# Example: https://campus-eats-api.onrender.com
BOT_WEBHOOK_URL=
# Any random string; Telegram sends it back so we know the request is genuine
BOT_WEBHOOK_SECRET=change-me-to-a-random-string

# REQUIRED for you to get the admin dashboard.
# Your Telegram numeric user ID(s), comma separated. Get it from @userinfobot
ADMIN_TELEGRAM_IDS=

# Frontend origin(s) allowed to call the API, comma separated.
# Leave empty in development to allow everything.
# Example: https://campus-eats.vercel.app
CORS_ORIGINS=

# How long (seconds) a Telegram login stays valid before the user must reopen the app
INIT_DATA_MAX_AGE_SECONDS=86400

# DEVELOPMENT ONLY: lets you open the app in a normal browser without Telegram,
# by sending an "x-dev-telegram-id" header. Ignored when NODE_ENV=production.
DEV_AUTH_BYPASS=false

# Branding / locale
APP_NAME=Campus Eats
UNIVERSITY_NAME=Your University
CURRENCY=ETB
TIMEZONE=Africa/Addis_Ababa

# Business rules
ORDER_ACCEPT_TIMEOUT_MINUTES=5
UNCLAIMED_ALERT_MINUTES=15
MAX_ACTIVE_ORDERS_PER_CUSTOMER=3
MAX_ACTIVE_DELIVERIES_PER_DRIVER=3
DELIVERY_CODE_MAX_ATTEMPTS=5

# Image uploads (menu photos, cafe logos, driver ID photos) – https://cloudinary.com (free)
# If left empty, uploading is disabled but everything else works.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Driver wallet top-ups: automatic receipt verification ──
# direct   = the server reads the official Telebirr / CBE receipt itself (free)
# verifyet = use the Verify.ET paid API (works from any country, supports new CBE links)
# off      = every top-up waits for the admin to approve it manually
PAYMENT_VERIFIER=direct

# REQUIRED for automatic approval – the account(s) drivers send money to.
# A receipt is accepted only if the money went to THESE accounts.
TELEBIRR_RECEIVER_PHONE=
TELEBIRR_RECEIVER_NAME=
CBE_RECEIVER_ACCOUNT=
CBE_RECEIVER_NAME=

# Receipts older than this are not accepted (stops reuse of old payments)
TOPUP_MAX_AGE_HOURS=72

# Telebirr/CBE receipt pages usually block servers outside Ethiopia.
# If your backend is hosted abroad (Render, Railway…), upload relay/receipt-relay.php
# to any cheap Ethiopian cPanel host and put its URL + the secret key here.
VERIFY_RELAY_URL=
VERIFY_RELAY_KEY=

# CBE's receipt server sometimes sends an incomplete certificate chain.
# Only set to true if verification fails with a certificate error.
RECEIPT_TLS_INSECURE=false

# Only when PAYMENT_VERIFIER=verifyet – key from https://verify.et
VERIFYET_API_KEY=
VERIFYET_BASE_URL=https://verify.et
